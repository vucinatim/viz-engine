{
  "name": "viz-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "pnpm studio:dev",
    "build": "pnpm studio:build",
    "start": "pnpm --filter @viz-engine/app-viz-studio preview -- --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"apps/viz-studio/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"tools/**/*.{ts,mjs}\" \"*.{json,ts,mts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"apps/viz-studio/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"tools/**/*.{ts,mjs}\" \"*.{json,ts,mts,mjs}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"apps/viz-studio/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"tools/**/*.{ts,mjs}\" \"*.{ts,mts,mjs}\" --max-warnings 0",
    "app:typecheck": "pnpm studio:typecheck",
    "app:check": "pnpm studio:typecheck && pnpm studio:build",
    "build:packages": "pnpm --recursive --filter \"./packages/**\" build",
    "typecheck:packages": "pnpm --recursive --filter \"./packages/**\" lint",
    "studio:dev": "pnpm --filter @viz-engine/app-viz-studio dev",
    "studio:build": "pnpm --filter @viz-engine/app-viz-studio build",
    "studio:typecheck": "pnpm --filter @viz-engine/app-viz-studio typecheck",
    "viz": "tsx packages/viz-dev-cli/src/index.ts",
    "viz:built": "pnpm build:packages && node packages/viz-dev-cli/dist/index.js",
    "viz:example:validate": "pnpm --filter @viz-engine/dev-cli dev example validate",
    "viz:example:frame": "pnpm --filter @viz-engine/dev-cli dev example frame --frame 36",
    "viz:example:svg": "pnpm --filter @viz-engine/dev-cli dev example svg --frame 36",
    "viz:bundle:validate": "pnpm --filter @viz-engine/dev-cli dev bundle validate --example",
    "viz:bundle:svg": "pnpm --filter @viz-engine/dev-cli dev bundle svg --example --frame 36",
    "smoke:consumer": "pnpm build:packages && node tools/foundation/package-consumer-smoke.mjs",
    "smoke:consumer:built": "node tools/foundation/package-consumer-smoke.mjs",
    "smoke:creative-loop": "pnpm build:packages && tsx tools/foundation/agent-creative-loop-scenario.ts",
    "smoke:creative-loop:built": "tsx tools/foundation/agent-creative-loop-scenario.ts",
    "production:signal-cathedral": "tsx tools/foundation/materialize-signal-cathedral-production.ts",
    "production:afterlight-assembly": "tsx tools/foundation/materialize-afterlight-assembly-production.ts",
    "render:browser-bundle": "tsx tools/foundation/render-browser-bundle.ts",
    "benchmark:runtime-preview": "tsx tools/foundation/runtime-preview-plan-benchmark.ts",
    "benchmark:editor-interaction": "VIZ_PERFORMANCE=1 VIZ_PERFORMANCE_REPORT=.artifacts/performance/v2-simple-example.json playwright test --config playwright.performance.config.ts",
    "benchmark:node-editor": "VIZ_PERFORMANCE=1 VIZ_GRAPH_PERFORMANCE_WORKLOAD=signal-cathedral VIZ_PERFORMANCE_REPORT=.artifacts/performance/v2-signal-cathedral-node-editor.json playwright test --config playwright.performance.config.ts",
    "benchmark:endurance": "VIZ_ENDURANCE=1 VIZ_ENDURANCE_REPORT=.artifacts/performance/v2-editor-endurance.json playwright test --config playwright.performance.config.ts",
    "benchmark:workspace-resize": "VIZ_WORKSPACE_RESIZE=1 playwright test --config playwright.performance.config.ts --grep \"authoring workspace\"",
    "benchmark:audio": "VIZ_AUDIO_PERFORMANCE_REPORT=.artifacts/performance/v2-audio-workflow.json playwright test tests/browser/audio-workflow.spec.ts",
    "benchmark:waveform": "VIZ_WAVEFORM_PERFORMANCE_REPORT=.artifacts/performance/v2-waveform-rhythm-workflow.json playwright test tests/browser/waveform-rhythm-workflow.spec.ts",
    "benchmark:artifact-container": "tsx tools/foundation/measure-audio-artifact-container.ts",
    "compare:runtime-performance": "tsx tools/foundation/compare-performance-recordings-cli.ts",
    "parity:validate": "node tools/foundation/validate-v1-v2-parity-matrix.mjs",
    "architecture:validate": "node tools/foundation/validate-workspace-dependencies.mjs",
    "metrics:source": "node tools/foundation/report-source-metrics.mjs",
    "typecheck:tools": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --types node tools/foundation/compare-performance-recordings.ts tools/foundation/compare-performance-recordings-cli.ts tools/foundation/render-browser-bundle.ts",
    "typecheck:foundation": "pnpm typecheck:packages && pnpm studio:typecheck && pnpm typecheck:tools",
    "build:foundation": "pnpm build:packages && pnpm studio:build",
    "test:foundation": "vitest run",
    "test:browser": "playwright test",
    "check:foundation": "pnpm parity:validate && pnpm architecture:validate && pnpm format:check && pnpm lint && pnpm typecheck:foundation && pnpm test:foundation && pnpm test:browser && pnpm build:packages && pnpm studio:build && pnpm smoke:consumer:built && pnpm smoke:creative-loop:built",
    "fixtures:update": "pnpm build:packages && tsx tools/foundation/generate-validation-golden-fixtures.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@viz-engine/rhythm-core": "workspace:*",
    "@xyflow/react": "^12.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "color": "^4.2.3",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.373.0",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.3",
    "react-resizable-panels": "^2.0.18",
    "react-use": "^17.6.0",
    "recharts": "^3.3.0",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.3.0",
    "three": "^0.164.1",
    "zod": "^3.23.4",
    "zod-metadata": "^1.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.62.0",
    "@types/color": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.164.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
