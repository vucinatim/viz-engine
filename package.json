{
  "name": "viz-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "pnpm studio:dev",
    "build": "pnpm studio:build",
    "start": "pnpm --filter @viz-engine/app-viz-studio preview -- --host 0.0.0.0",
    "lint": "pnpm typecheck:foundation",
    "app:typecheck": "pnpm studio:typecheck",
    "app:check": "pnpm studio:typecheck && pnpm studio:build",
    "build:packages": "pnpm --recursive --filter \"./packages/**\" build",
    "typecheck:packages": "pnpm --recursive --filter \"./packages/**\" lint",
    "studio:dev": "pnpm --filter @viz-engine/app-viz-studio dev",
    "studio:build": "pnpm --filter @viz-engine/app-viz-studio build",
    "studio:typecheck": "pnpm --filter @viz-engine/app-viz-studio typecheck",
    "viz": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli",
    "viz:example:validate": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli example validate",
    "viz:example:frame": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli example frame --frame 36",
    "viz:example:svg": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli example svg --frame 36",
    "viz:bundle:validate": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli bundle validate --example",
    "viz:bundle:svg": "pnpm build:packages && pnpm --filter @viz-engine/dev-cli cli bundle svg --example --frame 36",
    "smoke:consumer": "pnpm build:packages && node tools/foundation/package-consumer-smoke.mjs",
    "smoke:consumer:built": "node tools/foundation/package-consumer-smoke.mjs",
    "smoke:creative-loop": "pnpm build:packages && tsx tools/foundation/agent-creative-loop-scenario.ts",
    "benchmark:runtime-preview": "tsx tools/foundation/runtime-preview-plan-benchmark.ts",
    "compare:runtime-performance": "tsx tools/foundation/compare-performance-recordings-cli.ts",
    "parity:validate": "node tools/foundation/validate-v1-v2-parity-matrix.mjs",
    "typecheck:tools": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --types node tools/foundation/compare-performance-recordings.ts tools/foundation/compare-performance-recordings-cli.ts",
    "typecheck:foundation": "pnpm typecheck:packages && pnpm studio:typecheck && pnpm typecheck:tools",
    "build:foundation": "pnpm build:packages && pnpm studio:build",
    "test:foundation": "vitest run",
    "check:foundation": "pnpm parity:validate && pnpm typecheck:foundation && pnpm app:check && pnpm test:foundation && pnpm build:foundation && pnpm smoke:consumer:built && pnpm smoke:creative-loop",
    "fixtures:update": "pnpm build:packages && tsx tools/foundation/generate-validation-golden-fixtures.ts",
    "docs": "tsx docs/scripts/generate-docs.ts",
    "docs:dump": "tsx docs/scripts/dump-files.ts",
    "docs:tree": "tsx docs/scripts/create-tree.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-portal": "^1.0.4",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@remotion/cli": "^4.0.172",
    "@remotion/eslint-plugin": "^4.0.172",
    "@remotion/player": "4.0.172",
    "@types/jszip": "^3.4.1",
    "@viz-engine/rhythm-core": "workspace:*",
    "@xyflow/react": "^12.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "color": "^4.2.3",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.373.0",
    "react": "^18",
    "react-best-gradient-color-picker": "^3.0.7",
    "react-dom": "^18",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.3",
    "react-resizable-panels": "^2.0.18",
    "react-use": "^17.6.0",
    "recharts": "^3.3.0",
    "remotion": "^4.0.172",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.3.0",
    "three": "^0.164.1",
    "zod": "^3.23.4",
    "zod-metadata": "^1.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/color": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.11",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.164.0",
    "eslint": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tsx": "^4.20.5",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
