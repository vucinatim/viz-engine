{
  "name": "@viz-engine/dev-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "viz-dev": "./dist/index.js"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "cli": "tsx dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@viz-engine/example-projects": "workspace:*",
    "@viz-engine/runtime": "workspace:*"
  }
}
